<!-- Subtitle AutoSync. Keep keys in sync with values/autosync_strings.xml. -->
<resources>
    <string name="autosync_setting_title">字幕を自動同期</string>
    <string name="autosync_setting_description">選択したアドオン字幕を、動画に埋め込まれた字幕のタイミングに合わせます。</string>
    <string name="autosync_tolerance_title">Auto Sync の許容範囲</string>
    <string name="autosync_tolerance_description">必要な補正がこの値以下の場合は、元のタイミングを維持します。</string>
    <string name="autosync_tolerance_off">オフ</string>
    <string name="autosync_thorough_title">Auto Sync の徹底検索</string>
    <string name="autosync_thorough_description">同期する前に、他の字幕や埋め込みトラックと比較を続けて、より近い一致を探します。オフにすると、最初の確かな一致をより早く使います。信頼できる一致のみが適用されます。</string>
    <string name="autosync_debug_logs_title">Auto Sync のデバッグログ</string>
    <string name="autosync_debug_logs_description">難しい字幕の報告用に、Auto Sync の詳細なタイミングレポートを保存してクリップボードにコピーします。</string>
    <string name="autosync_toast_analyzing">Auto Sync • 解析中…</string>
    <string name="autosync_toast_synced">Auto Sync • 字幕を同期しました</string>
    <string name="autosync_toast_synced_replaced">Auto Sync • より一致する字幕に切り替えました</string>
    <string name="autosync_toast_in_sync">Auto Sync • 字幕はすでに同期しています</string>
    <string name="autosync_toast_failed">Auto Sync • 同期に失敗しました • 字幕のタイミングは変更されていません</string>
    <string name="autosync_toast_failed_no_reference">Auto Sync • 比較できる埋め込み字幕がありません • 字幕のタイミングは変更されていません</string>
    <string name="autosync_toast_failed_unsupported">Auto Sync • 非対応の字幕形式です • 字幕のタイミングは変更されていません</string>
    <string name="autosync_toast_failed_audio_fallback">Auto Sync • 一致が見つかりません • 代わりに音声に同期しています…</string>
    <string name="autosync_label_synced">自動同期済み</string>
</resources>
