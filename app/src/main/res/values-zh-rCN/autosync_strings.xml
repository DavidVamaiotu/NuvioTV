<resources>
    <string name="autosync_setting_title">自动同步字幕</string>
    <string name="autosync_setting_description">将所选插件字幕与视频内嵌字幕的时间轴对齐。</string>
    <string name="autosync_tolerance_title">Auto Sync 容差</string>
    <string name="autosync_tolerance_description">所需校正不超过此值时，保留原始时间轴。</string>
    <string name="autosync_tolerance_off">关闭</string>
    <string name="autosync_thorough_title">Auto Sync 深入搜索</string>
    <string name="autosync_thorough_description">同步前继续比较其他字幕和内嵌轨道，以寻找更贴近的匹配。关闭时会更早采用第一个可靠匹配。只会应用可信的匹配。</string>
    <string name="autosync_debug_logs_title">Auto Sync 调试日志</string>
    <string name="autosync_debug_logs_description">保存详细的 Auto Sync 时间轴报告并复制到剪贴板，便于反馈疑难字幕问题。</string>
