<resources>
    <string name="autosync_setting_title">自動同步字幕</string>
    <string name="autosync_setting_description">將所選外掛字幕對齊影片內嵌字幕的時間軸。</string>
    <string name="autosync_tolerance_title">Auto Sync 容許誤差</string>
    <string name="autosync_tolerance_description">所需校正不超過此值時，保留原始時間軸。</string>
    <string name="autosync_tolerance_off">關閉</string>
    <string name="autosync_thorough_title">Auto Sync 深入搜尋</string>
    <string name="autosync_thorough_description">同步前繼續比較其他字幕和內嵌軌道，以尋找更貼近的相符結果。關閉時會更早採用第一個可靠的相符結果。只會套用可信的相符結果。</string>
    <string name="autosync_debug_logs_title">Auto Sync 偵錯記錄</string>
    <string name="autosync_debug_logs_description">儲存詳細的 Auto Sync 時間軸報告並複製到剪貼簿，方便回報疑難字幕問題。</string>
